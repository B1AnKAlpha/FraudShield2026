MINERU_API_TOKEN=
ANALYSIS_LLM_API_KEY=
ANALYSIS_LLM_BASE_URL=https://api.siliconflow.cn/v1
ANALYSIS_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
ANALYSIS_ENABLE_LLM_NORMALIZATION=true
ANALYSIS_HTTP_TRUST_ENV=false

# Leave empty to disable TOTP bypass (production). Set a value for dev convenience.
AUTH_DEV_TOTP_BYPASS=
# Path to legacy torch python interpreter. Defaults to "python" if unset.
LEGACY_TORCH_PYTHON=python
# Root directory of the legacy Project folder. Defaults to ../../Project relative to server/.
# LEGACY_ROOT=C:\path\to\Project
