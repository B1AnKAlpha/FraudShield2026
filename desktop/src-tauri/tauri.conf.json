{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FraudShield2026",
  "version": "0.1.0",
  "identifier": "com.fraudshield.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173"
  },
  "app": {
    "windows": [
      {
        "title": "FraudShield 2026",
        "width": 1440,
        "height": 960,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "resources": ["security/integrity-manifest.json"],
    "icon": ["icons/icon.ico"]
  }
}
